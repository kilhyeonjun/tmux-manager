# tmux-manager shellcheck config
# zsh-only project — shellcheck does not natively support zsh.
# Suppress false positives for zsh-specific constructs.
shell=bash
disable=SC1009,SC1036,SC1058,SC1072,SC1073,SC1090,SC1091,SC1094,SC2012,SC2015,SC2028,SC2030,SC2031,SC2034,SC2086,SC2128,SC2129,SC2154,SC2155,SC2164,SC2168,SC2170,SC2296,SC2299
